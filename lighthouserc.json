{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "numberOfRuns": 1,
      "settings": {
        "skipAudits": [
          "uses-http2",
          "canonical"
        ]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.9
              }
            ],
            "unused-javascript": "off",
            "uses-long-cache-ttl": "off",
            "legacy-javascript": "off"
          }
        },
        {
          "matchingUrlPattern": "^(?!.*/projects/index\\.html).*$",
          "assertions": {
            "categories:performance": [
              "warn",
              {
                "minScore": 0.9
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./.lighthouseci"
    }
  }
}
